# ─────────────────────────────────────────────────────────────
#  .gitignore — Vulnerability Analysis Agent
# ─────────────────────────────────────────────────────────────

# ── Secrets & Credentials (NEVER commit these) ───────────────
.env
*.key
*.pem
*.p12
*.pfx
seeded_ids.json
seeded_vit_ids.json

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
.env.local
.env.*.local

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.coveragerc
nosetests.xml
test-results/

# MyPy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# ── Logs & Temp Files ────────────────────────────────────────
*.log
*.tmp
*.bak
*.swp
*.swo
*~

# ── OS Generated ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── IDE & Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.launch

# ── Node (if any frontend tooling added later) ───────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Docker ───────────────────────────────────────────────────
*.dockerignore

# ── Generated / Runtime Data ─────────────────────────────────
# Keep mock data and server registry (demo reference files)
# but exclude any auto-generated runtime outputs
analysis_output*.json
remediation_report*.json
