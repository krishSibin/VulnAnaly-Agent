SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=

AUTOPILOT=0
AUTOPILOT_MIN_SCORE=70

# ─────────────────────────────────────────────────────────
# LLM MODE — set ONE of the two keys below:
#
#   HOME MODE : Set GEMINI_API_KEY (get from Google AI Studio)
#               https://aistudio.google.com/apikey
#
#   LAB MODE  : Set TCS_GATEWAY_KEY (provided at TCS AI Lab)
#               Gateway URL: https://genailab.tcs.in
#               Model used : gemini-2.5-flash
#
# If neither is set, the agent uses smart heuristic analysis (works offline).
# ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
TCS_GATEWAY_KEY=





